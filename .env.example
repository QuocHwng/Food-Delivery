# ─── Environment Variables Example ───────────────────────────────────────────
# Copy file này thành .env và điền giá trị thực

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=foodadmin
POSTGRES_PASSWORD=secret
POSTGRES_DB=food_delivery
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://foodadmin:secret@localhost:5432/food_delivery?sslmode=disable

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-very-secret-access-key-here
JWT_REFRESH_SECRET=your-very-secret-refresh-key-here
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── VNPay Sandbox ─────────────────────────────────────────────────────────────
VNPAY_TMN_CODE=your-sandbox-tmn-code
VNPAY_HASH_SECRET=your-sandbox-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
RESTAURANT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# ── Service URLs (dùng trong Gateway) ────────────────────────────────────────
USER_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
RESTAURANT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
